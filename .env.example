# Copiar este archivo a ".env" en la raíz del proyecto y completar los valores.
# docker-compose.yml lee este archivo (env_file) e inyecta estas variables como
# variables de entorno reales dentro del contenedor del backend — no hace falta que
# exista un .env dentro de backend/ para correr con Docker.

# --- PostgreSQL ---
POSTGRES_USER=rematar
POSTGRES_PASSWORD=rematar
POSTGRES_DB=rematar

# --- Backend: identidad y entorno ---
PROJECT_NAME=RematAR
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Backend: base de datos ---
# Dentro de docker-compose, el host de la base es el nombre del servicio ("db"), no
# "localhost". Si corrés el backend fuera de Docker contra la misma base expuesta en
# el puerto 5432, cambiá "db" por "localhost".
DATABASE_URL=postgresql+asyncpg://rematar:rematar@db:5432/rematar

# --- Backend: Redis (Épica 3, Módulo 3.1) ---
# Mismo criterio que DATABASE_URL: dentro de docker-compose el host es "redis" (nombre
# del servicio), no "localhost". DB 0 para desarrollo normal; los tests usan la DB 1
# (ver backend/tests/conftest.py) para no pisar datos si corrés ambos contra el mismo
# Redis. Sin contraseña en desarrollo local (Redis no queda expuesto fuera de la red de
# Docker salvo el puerto mapeado explícitamente para debugging).
REDIS_URL=redis://redis:6379/0

# --- Backend: JWT ---
# Generar un valor real y secreto, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-real-secret-before-running-anywhere-but-localhost
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend: CORS (para el futuro frontend Vite) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- Backend: bootstrap del primer administrador ---
# Usado únicamente por: docker compose exec backend python -m app.scripts.create_superuser
# Ojo con el dominio: "email-validator" (usado por Pydantic EmailStr) rechaza TLDs
# reservados por IANA para uso especial (.local, .test, .example, .invalid, .localhost),
# así que un placeholder como "admin@rematar.local" falla la validación. Usá un dominio
# cualquiera no reservado, aunque no exista de verdad (esto se descubrió en la práctica
# durante la Fase 1, ver docs/09-arquitectura-y-decisiones.md).
FIRST_ADMIN_EMAIL=admin@rematar.io
FIRST_ADMIN_PASSWORD=administrador123
FIRST_ADMIN_FULL_NAME=Administrador RematAR
