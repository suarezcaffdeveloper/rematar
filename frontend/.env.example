# Copiar este archivo a ".env" en esta carpeta y completar los valores.
# Vite solo expone al cliente las variables prefijadas "VITE_" -- ver
# src/shared/config/env.ts.

# URL base de la API del backend, incluido el prefijo de versión.
# Dentro de Docker Compose, si el frontend corriera del lado del servidor necesitaría
# el nombre del servicio ("backend"); acá no aplica: el navegador del usuario es quien
# hace estos requests, siempre contra localhost o el dominio público real.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Clave pública de Mercado Pago (Checkout API), para tokenizar la tarjeta del comprador
# en el navegador vía el Payment Brick -- garantía económica (bloqueo de tarjeta),
# `backend/app/modules/garantias/`. Opcional: sin ella, un remate que exige garantía
# muestra el aviso de "no disponible en este entorno" en vez del formulario de tarjeta
# (mismo criterio opt-in que `MERCADOPAGO_ENABLED` del lado del backend). NUNCA la clave
# de acceso (Access Token) acá -- esta es la única de las dos claves de Mercado Pago
# pensada para vivir en el navegador.
VITE_MERCADOPAGO_PUBLIC_KEY=
