# Copiar este archivo a ".env" en esta carpeta y completar los valores.
# Vite solo expone al cliente las variables prefijadas "VITE_" -- ver
# src/shared/config/env.ts.

# URL base de la API del backend, incluido el prefijo de versión.
# Dentro de Docker Compose, si el frontend corriera del lado del servidor necesitaría
# el nombre del servicio ("backend"); acá no aplica: el navegador del usuario es quien
# hace estos requests, siempre contra localhost o el dominio público real.
VITE_API_BASE_URL=http://localhost:8000/api/v1
